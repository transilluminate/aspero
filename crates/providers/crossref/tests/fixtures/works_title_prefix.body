lbers","year":"2021","journal-title":"JAMA Neurol"},{"issue":"10543","key":"jrv260024r42","doi-asserted-by":"publisher","first-page":"2015","DOI":"10.1016\/S0140-6736(26)00876-7","article-title":"Endovascular thrombectomy for patients with large-core ischaemic stroke presenting up to 24 h after onset (ATLAS): a systematic review and individual patient data meta-analysis with central imaging adjudication.","volume":"407","author":"Sarraj","year":"2026","journal-title":"Lancet"},{"issue":"15","key":"jrv260024r43","doi-asserted-by":"publisher","first-page":"1361","DOI":"10.1056\/NEJMoa2206317","article-title":"Trial of endovascular treatment of acute basilar-artery occlusion.","volume":"387","author":"Tao","year":"2022","journal-title":"N Engl J Med"},{"issue":"15","key":"jrv260024r44","doi-asserted-by":"publisher","first-page":"1373","DOI":"10.1056\/NEJMoa2207576","article-title":"Trial of thrombectomy 6 to 24 hours after stroke due to basilar-artery occlusion.","volume":"387","author":"Jovin","year":"2022","journal-title":"N Engl J Med"},{"issue":"9","key":"jrv260024r45","doi-asserted-by":"publisher","first-page":"826","DOI":"10.1001\/jama.2022.1645","article-title":"Effect of intra-arterial alteplase vs placebo following successful thrombectomy on functional outcomes in patients with large vessel occlusion acute ischemic stroke: the CHOICE randomized clinical trial.","volume":"327","author":"Ren\u00fa","year":"2022","journal-title":"JAMA"},{"issue":"21","key":"jrv260024r46","doi-asserted-by":"publisher","first-page":"1859","DOI":"10.1001\/jama.2026.5164","article-title":"Adjunctive intra-arterial alteplase after successful thrombectomy for acute ischemic stroke: the CHOICE-2 randomized clinical trial.","volume":"335","author":"Ren\u00fa","year":"2026","journal-title":"JAMA"},{"issue":"7","key":"jrv260024r47","doi-asserted-by":"publisher","first-page":"589","DOI":"10.1001\/jama.2024.23480","article-title":"Intra-arterial urokinase after endovascular reperfusion for a