istered":"2024-01-16T01:41:57Z","published":null,"updated":"2024-01-16T01:41:57Z"},"relationships":{"client":{"data":{"id":"kudos.kudos","type":"clients"}}}},{"id":"10.48550/arxiv.1706.03762","type":"dois","attributes":{"doi":"10.48550/arxiv.1706.03762","identifiers":[{"identifier":"1706.03762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ashish","familyName":"Vaswani","name":"Vaswani, Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noam","familyName":"Shazeer","name":"Shazeer, Noam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niki","familyName":"Parmar","name":"Parmar, Niki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakob","familyName":"Uszkoreit","name":"Uszkoreit, Jakob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Llion","familyName":"Jones","name":"Jones, Llion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aidan N.","familyName":"Gomez","name":"Gomez, Aidan N.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukasz","familyName":"Kaiser","name":"Kaiser, Lukasz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Illia","familyName":"Polosukhin","name":"Polosukhin, Illia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention Is All You Need"}],"publisher":"arXiv","container":{},"publicationYear":2017,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2017-06-12T17:57:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2017-06-13T00:13:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2017-06-19T16:49:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2017-06-20T00:14:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2017-06-20T05:20:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2017-06-21T00:04:53Z","dateType":"Updated","dateInformation":"v3"},{"date":"2017-06-30T17:29:30Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2017-07-03T00:08:10Z","dateType":"Updated","dateInformation":"v4"},{"date":"2017-12-06T03:30:32Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2017-12-07T01:03:11Z","dateType":"Updated","dateInformation":"v5"},{"date":"2023-07-24T00:48:54Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2023-07-25T00:34:06Z","dateType":"Updated","dateInformation":"v6"},{"date":"2023-08-02T00:41:18Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2023-08-03T00:07:25Z","dateType":"Updated","dateInformation":"v7"},{"date":"2017-06","dateType":"Available","dateInformation":"v1"},{"date":"2017","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The dominant sequence transduction models are based on complex recurrent or convolutional neural networks in an encoder-decoder configuration. The best performing models also connect the encoder and decoder through an attention mechanism. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely. Experiments on two machine translation tasks show these models to be superior in quality while being more parallelizable and requiring significantly less time to train. Our model achieves 28.4 BLEU on the WMT 2014 English-to-German translation task, improving over the existing best results, including ensembles by over 2 BLEU. On the WMT 2014 English-to-French translation task, our model establishes a new single-model state-of-the-art BLEU score of 41.8 after training for 3.5 days on eight GPUs, a small fraction of the training costs of the best models from the literature. We show that the Transformer generalizes well to other tasks by applying it successfully to English constituency parsing both with large and limited training data."},{"descriptionType":"Other","description":"15 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/1706.03762","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":2,"citationCount":69,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2022-03-04T06:13:33Z","registered":"2022-03-04T06:13:34Z","published":null,"updated":"2025-04-09T22:52:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":2836,"totalPages":946,"page":1},"links":{"self":"https://api.datacite.org/dois?query=%28attention+is+all+you+need%29\u0026sort=relevance\u0026page[number]=1\u0026page[size]=3","next":"https://api.datacite.org/dois?page%5Bnumber%5D=2\u0026page%5Bsize%5D=3\u0026query=%28attention+is+all+you+need%29"}}