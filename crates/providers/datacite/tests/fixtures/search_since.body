[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial 4.0 International","rightsIdentifier":"cc-by-nc-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The definition of sepsis has evolved from SIRS-based criteria (Sepsis-1 and Sepsis-2) to focus on organ dysfunction in Sepsis-3, aiding in more precise diagnosis and management."}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.24092436","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-11-09T20:15:15Z","registered":"2026-11-09T20:15:15Z","published":null,"updated":"2026-11-09T20:15:15Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}},{"id":"10.17632/57f6wsjhp9","type":"dois","attributes":{"doi":"10.17632/57f6wsjhp9","identifiers":[],"creators":[{"nameType":"Personal","givenName":"hui","familyName":"lin","name":"lin, hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Shaoxing University"],"givenName":"Haodi ","familyName":"Gu","name":"Gu, Haodi ","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinrou ","familyName":"Yu","name":"Yu, Xinrou ","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liping ","familyName":"Meng","name":"Meng, Liping ","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-6139-2031"}],"affiliation":[]},{"nameType":"Personal","givenName":"Yue ","familyName":"Shan","name":"Shan, Yue ","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0009-0006-2956-8881"}],"affiliation":[]}],"titles":[{"title":"ACT1-dependent stabilization of Hif1a mRNA links IL-17A to ferroptosis-associated cardiac injury in sepsis"}],"publisher":"Mendeley Data","container":{},"publicationYear":2026,"subjects":[{"subject":"Sepsis"},{"subject":"Cardiology"}],"contributors":[{"nameType":"Organizational","name":"Zhejiang University","nameIdentifiers":[{"nameIdentifierScheme":"ROR","schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/00a2xv884"}],"contributorType":"Other","affiliation":[]},{"nameType":"Organizational","name":"Shaoxing People's Hospital","nameIdentifiers":[{"nameIdentifierScheme":"ROR","schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/05v58y004"}],"contributorType":"Other","affiliation":[]},{"nameType":"Organizational","name":"Shaoxing University","nameIdentifiers":[{"nameIdentifierScheme":"ROR","schemeUri":"https://ror.org","nameIdentifier":"https://ror.org/0435tej63"}],"contributorType":"Other","affiliation":[]}],"dates":[{"date":"2026-11-01T15:38:12Z","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"Dataset","resourceTypeGeneral":"Dataset","citeproc":"dataset","bibtex":"misc","ris":"DATA","resourceType":"Dataset"},"relatedIdentifiers":[{"relationType":"HasVersion","resourceTypeGeneral":"Dataset","relatedIdentifier":"10.17632/57f6wsjhp9.1","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rightsUri":"info:eu-repo/semantics/openAccess"},{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This dataset is being prepared to accompany the manuscript “ACT1-dependent stabilization of Hif1a mRNA links IL-17A to ferroptosis-associated cardiac injury in sepsis”, which investigates the relationship between IL-17A signaling, ACT1-dependent regulation of Hif1a mRNA, and ferroptosis-associated myocardial injury.\nThe prepared collection includes de-identified clinical data from 127 participants, comprising 87 patients with sepsis and 40 healthy reference controls; tabulated immune-cell measurements and flow-cytometry event files; biochemical assay readings and quantitative analysis tables; animal echocardiography, histology and microscopy files; immunoblot images and densitometric measurements; ACT1/HIF-1alpha perturbation and rescue experiment data; and AC16 cell data from individual patient-serum exposure experiments. Available processed transcriptomic results and supplementary materials are also included.\nFiles are organized by experimental domain. Native Excel and GraphPad Prism files are accompanied, where available, by CSV exports. A README, file manifest, worksheet and Prism-table indexes, and a figure-to-data coverage table describe the contents, provenance, transformations and outstanding gaps. Native files and their CSV exports represent the same observations and should not be counted as independent datasets.\nDirect clinical record identifiers have been removed from the prepared clinical tables. Flow-cytometry files have undergone metadata cleaning, with event values and channel information checked for preservation. Public transcriptomic datasets reused in the study are identified separately by the manuscript-reported GEO accessions GSE79962, GSE190856 and GSE290679.\nThis is an incomplete draft deposit undergoing author verification. Simulated experimental-planning templates are excluded. Verified reporter-assay acquisition records, complete generated RNA-sequencing data, additional single-cell numerical outputs and analysis code, and some sample-to-figure mappings remain outstanding. This draft should not yet be considered a complete collection of the data required to reproduce all manuscript findings."}],"geoLocations":[],"fundingReferences":[{"funderIdentifierType":"ROR","funderName":"Zhejiang Provincial Natural Science Foundation","funderIdentifier":"https://ror.org/04aqat463"},{"funderIdentifierType":"ROR","funderName":"Science and Technology Department of Zhejiang Province","funderIdentifier":"https://ror.org/05yj3y977"}],"url":"https://data.mendeley.com/datasets/57f6wsjhp9","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":1,"versionOfCount":0,"created":"2026-11-01T15:38:12Z","registered":"2026-11-01T15:38:12Z","published":null,"updated":"2026-11-01T15:38:12Z"},"relationships":{"client":{"data":{"id":"bl.mendeley","type":"clients"}}}}],"meta":{"total":280,"totalPages":94,"page":1},"links":{"self":"https://api.datacite.org/dois?query=%28sepsis%29+AND+created%3a%5b2026-11-01+TO+%2a%5d\u0026sort=relevance\u0026page[number]=1\u0026page[size]=3","next":"https://api.datacite.org/dois?page%5Bnumber%5D=2\u0026page%5Bsize%5D=3\u0026query=%28sepsis%29+AND+created%3A%5B2026-11-01+TO+%2A%5D"}}