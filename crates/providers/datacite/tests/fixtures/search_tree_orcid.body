{"data":[{"id":"10.5281/zenodo.10600863","type":"dois","attributes":{"doi":"10.5281/zenodo.10600863","identifiers":[],"creators":[{"nameType":"Personal","affiliation":["Ministry of Higher Education and Research"],"givenName":"Marin","familyName":"Dacos","name":"Dacos, Marin","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-9361-5295"}]},{"nameType":"Personal","affiliation":["NASA"],"givenName":"Steve","familyName":"Crawford","name":"Crawford, Steve","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-8969-5229"}]},{"nameType":"Personal","affiliation":["Ministry of Higher Education and Research"],"givenName":"Eric","familyName":"Jeangirard","name":"Jeangirard, Eric","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Curtin University"],"givenName":"Lucy","familyName":"Montgomery","name":"Montgomery, Lucy","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Curtin University"],"givenName":"Cameron","familyName":"Neylon","name":"Neylon, Cameron","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Redalyc"],"givenName":"Arianna","familyName":"Becerril","name":"Becerril, Arianna","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["OpenAlex"],"givenName":"Jason","familyName":"Priem","name":"Priem, Jason","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0001-6187-6610"}]},{"nameType":"Personal","affiliation":["science-miner"],"givenName":"Patrice","familyName":"Lopez","name":"Lopez, Patrice","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["UMC Utrecht"],"givenName":"Inge","familyName":"Stegeman","name":"Stegeman, Inge","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0001-5154-7178"}]},{"nameType":"Personal","affiliation":["Leiden University"],"givenName":"Ismael","familyName":"Rafols","name":"Rafols, Ismael","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-6527-7778"}]},{"nameType":"Personal","affiliation":["United Nations Educational, Scientific and Cultural Organization"],"givenName":"Ana","familyName":"Persic","name":"Persic, Ana","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Ministry of Higher Education and Research"],"givenName":"Nicolas","familyName":"Fressengeas","name":"Fressengeas, Nicolas","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-5534-712X"}]},{"nameType":"Personal","affiliation":["Leiden University"],"givenName":"Ludo","familyName":"Waltman","name":"Waltman, Ludo","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0001-8249-1752"}]},{"nameType":"Personal","affiliation":["Sesame Open Science"],"givenName":"Bianca","familyName":"Kramer","name":"Kramer, Bianca","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-5965-6560"}]},{"nameType":"Personal","affiliation":["Public Library of Science"],"givenName":"Iain","familyName":"Hrynaszkiewicz","name":"Hrynaszkiewicz, Iain","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-9673-5559"}]},{"nameType":"Personal","affiliation":["Université de Montréal"],"givenName":"Vincent","familyName":"Larivière","name":"Larivière, Vincent","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-2733-0689"}]},{"nameType":"Personal","affiliation":["European Organization for Nuclear Research"],"givenName":"Kamran","familyName":"Naim","name":"Naim, Kamran","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-6344-7833"}]},{"nameType":"Personal","affiliation":["SciLifeLab"],"givenName":"Christopher","familyName":"Erdmann","name":"Erdmann, Christopher","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0003-2554-180X"}]},{"nameType":"Personal","affiliation":["DataCite"],"givenName":"Gabriela","familyName":"Mejias","name":"Mejias, Gabriela","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-1598-7181"}]},{"nameType":"Personal","affiliation":["Berkeley Institute for Data Science"],"givenName":"Karthik","familyName":"Ram","name":"Ram, Karthik","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Utrecht University"],"givenName":"Jonathan","familyName":"de Bruin","name":"de Bruin, Jonathan","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-4297-0502"}]},{"nameType":"Personal","givenName":"Laurent","familyName":"Romary","name":"Romary, Laurent","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-0756-0508"}],"affiliation":[]},{"nameType":"Personal","affiliation":["Université de Lorraine"],"givenName":"Laetitia","familyName":"Bracco","name":"Bracco, Laetitia","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-2939-9110"}]}],"titles":[{"title":"Building an Open Science Monitoring Framework with open technologies"}],"publisher":"Zenodo","container":{},"publicationYear":2024,"subjects":[],"contributors":[],"dates":[{"date":"2024-01-31","dateType":"Issued"}],"language":"en","types":{"schemaOrg":"ScholarlyArticle","resourceTypeGeneral":"Text","citeproc":"article-journal","bibtex":"article","ris":"RPRT","resourceType":"Presentation"},"relatedIdentifiers":[{"relationType":"HasVersion","relatedIdentifier":"10.5281/zenodo.10600864","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text from : https://www.ouvrirlascience.fr/building-an-open-science-monitoring-framework-with-open-technologies-unesco-workshop-19-12-23/\n\nThe worldwide development of public policies promoting open science implies that indicators need to be produced to allow their monitoring. The objective to reach is to enable the measurement of the scientific production openness, as well as its impact on the scientific process itself, and ultimately for society as a whole. Until now, efforts to achieve this have mainly focused on measuring the openness of research publications as well as of data and software produced by research along with that of the results of clinical trials and publication costs. In its Recommendation on Open Science, UNESCO encourages all its member countries to implement indicators. The international nature of research makes it essential for these indicators to be geographically and institutionally consistent worldwide. Many initiatives around the world aim to gauge the openness of science. It therefore seems useful to bring these together to work towards a convergence of general principles for monitoring the progress of open science.\n\nFor these reasons, France and UNESCO organised a workshop at UNESCO headquarters in Paris on December 19th 2023 to work towards achieving this objective. The day enabled international open science monitoring stakeholders to coordinate their efforts and foster the creation of an international community to drive the issue.\n\nOver fifty experts from research organisations, universities, national agencies and nonprofit organisations from three continents (in Australia, Denmark, Japan, Mexico, Germany, the Netherlands, the United States, Canada, Argentina, France, Belgium, the United Kingdom, Spain, Switzerland, Italy and Portugal) came to Paris to take part in the event. Among the many institutions represented were the CERN, NASA, CWTS, OurResearch, Crossref, DataCite, SPARC Europe, Redalyc, the OECD, COKI, the Max Plank Digital Library, PLOS, CLACSO and the Hcéres (Science and Technology Observatory).\n\nThe principles for monitoring open science which the participants worked on aim to establish common guidelines for the various initiatives described above. More specifically they worked on the relevance of the indicators to be selected as well as on their transparency and reproducibility. Technical specifications will follow, aimed at bolstering the foundations of the nascent international open science monitoring community. This initiative’s objective is to simplify the implementation of open science monitoring initiatives for organisations and countries that require them.\n\nThe presentations of the workshop are available below."}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.10600863","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":1,"versionOfCount":0,"created":"2024-01-31T17:24:31Z","registered":"2024-01-31T17:24:31Z","published":null,"updated":"2024-02-16T17:48:28Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}},{"id":"10.5281/zenodo.12684249","type":"dois","attributes":{"doi":"10.5281/zenodo.12684249","identifiers":[{"identifier":"oai:zenodo.org:12684249","identifierType":"oai"},{"identifier":"https://altmetrics.org/manifesto","identifierType":"URL"}],"creators":[{"nameType":"Personal","givenName":"Jason","familyName":"Priem","name":"Priem, Jason","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0001-6187-6610"}],"affiliation":[]},{"nameType":"Personal","givenName":"Dario","familyName":"Taraborelli","name":"Taraborelli, Dario","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-0082-8508"}],"affiliation":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Groth","name":"Groth, Paul","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0003-0183-6910"}],"affiliation":[]},{"nameType":"Personal","givenName":"Cameron","familyName":"Neylon","name":"Neylon, Cameron","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","nameIdentifier":"0000-0002-0068-716X"}],"affiliation":[]}],"titles":[{"title":"Altmetrics: A manifesto"}],"publisher":"Zenodo","container":{},"publicationYear":2010,"subjects":[{"subject":"altmetrics"},{"subject":"scientometrics"},{"subject":"open science"},{"subject":"scholarly communication"}],"contributors":[],"dates":[{"date":"2010-10-26","dateType":"Issued"}],"language":"en","types":{"schemaOrg":"ScholarlyArticle","resourceTypeGeneral":"Text","citeproc":"article-journal","bibtex":"article","ris":"RPRT","resourceType":""},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.12684248","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1.01","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/doi/10.5281/zenodo.12684249","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2024-07-08T10:13:59Z","registered":"2024-07-08T10:13:59Z","published":null,"updated":"2024-07-08T10:14:00Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}},{"id":"10.5281/zenodo.3474006","type":"dois","attributes":{"doi":"10.5281/zenodo.3474006","identifiers":[{"identifier":"https://zenodo.org/record/3474007","identifierType":"URL"}],"creators":[{"nameType":"Personal","affiliation":["Our Research"],"givenName":"Heather","familyName":"Piwowar","name":"Piwowar, Heather","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0003-1613-5981"}]},{"nameType":"Personal","affiliation":["Our Research"],"givenName":"Jason","familyName":"Priem","name":"Priem, Jason","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0001-6187-6610"}]},{"nameType":"Personal","affiliation":["Our Research"],"givenName":"Richard","familyName":"Orr","name":"Orr, Richard","nameIdentifiers":[{"nameIdentifierScheme":"ORCID","schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-5503-9370"}]}],"titles":[{"title":"Data From: The Future of OA: A large-scale analysis projecting Open Access publication and readership"}],"publisher":"Zenodo","container":{"identifier":"https://zenodo.org/communities/osr","identifierType":"URL","type":"DataRepository"},"publicationYear":2019,"subjects":[],"contributors":[],"dates":[{"date":"2019-10-05","dateType":"Issued"}],"language":"en","types":{"schemaOrg":"Dataset","resourceTypeGeneral":"Dataset","citeproc":"dataset","bibtex":"misc","ris":"DATA"},"relatedIdentifiers":[{"relationType":"IsSupplementedBy","resourceTypeGeneral":"Software","relatedIdentifier":"https://github.com/Impactstory/future-oa","relatedIdentifierType":"URL"},{"relationType":"Compiles","resourceTypeGeneral":"Text","relatedIdentifier":"10.1101/795310","relatedIdentifierType":"DOI"},{"relationType":"HasVersion","relatedIdentifier":"10.5281/zenodo.3474007","relatedIdentifierType":"DOI"},{"relationType":"IsPartOf","relatedIdentifier":"https://zenodo.org/communities/osr","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"},{"rightsUri":"info:eu-repo/semantics/openAccess","rights":"Open Access"}],"descriptions":[{"descriptionType":"Abstract","description":"This is the raw data behind the publication on bioRxiv at https://doi.org/10.1101/795310: \u003cstrong\u003ePiwowar, Priem, Orr (2019) The Future of OA: A large-scale analysis projecting Open Access publication and readership. bioRxiv: https://doi.org/10.1101/795310\u003c/strong\u003e The jupyter notebook that produces the manuscript using the data here is available at: https://github.com/Impactstory/future-oa Summary: Understanding the growth of open access (OA) is important for deciding funder policy, subscription allocation, and infrastructure planning. This study analyses the number of papers available as OA over time. The models includes both OA embargo data and the relative growth rates of different OA types over time, based on the OA status of 70 million journal articles published between 1950 and 2019. The study also looks at article usage data, analyzing the proportion of views to OA articles vs views to articles which are closed access. Signal processing techniques are used to model how these viewership patterns change over time. Viewership data is based on 2.8 million uses of the Unpaywall browser extension in July 2019. We found that Green, Gold, and Hybrid papers receive more views than their Closed or Bronze counterparts, particularly Green papers made available within a year of publication. We also found that the proportion of Green, Gold, and Hybrid articles is growing most quickly. In 2019: 31% of all journal articles are available as OA 52% of article views are to OA articles Given existing trends, we estimate that by 2025: 44% of all journal articles will be available as OA 70% of article views will be to OA articles The declining relevance of closed access articles is likely to change the landscape of scholarly communication in the years to come."},{"descriptionType":"Other","description":"The jupyter notebook that produces the manuscript using the data here is available at: https://github.com/Impactstory/future-oa."}],"geoLocations":[],"fundingReferences":[],"url":"https://zenodo.org/record/3474006","contentUrl":null,"metadataVersion":3,"schemaVersion":null,"source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2019-10-05T20:07:20Z","registered":"2019-10-05T20:07:20Z","published":null,"updated":"2020-07-30T05:51:09Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}}}}],"meta":{"total":8,"totalPages":3,"page":1},"links":{"self":"https://api.datacite.org/dois?query=creators.nameIdentifiers.nameIdentifier%3a%28%22https%3a%2f%2forcid.org%2f0000-0001-6187-6610%22+OR+%220000-0001-6187-6610%22%29+AND+language%3a%28en+OR+eng%29\u0026sort=relevance\u0026page[number]=1\u0026page[size]=3","next":"https://api.datacite.org/dois?page%5Bnumber%5D=2\u0026page%5Bsize%5D=3\u0026query=creators.nameIdentifiers.nameIdentifier%3A%28%22https%3A%2F%2Forcid.org%2F0000-0001-6187-6610%22+OR+%220000-0001-6187-6610%22%29+AND+language%3A%28en+OR+eng%29"}}