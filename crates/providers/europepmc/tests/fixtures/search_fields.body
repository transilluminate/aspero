etersen","firstName":"Stig","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Senior AW","lastName":"Senior","firstName":"Andrew W","initials":"AW","authorId":{"type":"ORCID","value":"0000-0002-2401-5691"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Kavukcuoglu K","lastName":"Kavukcuoglu","firstName":"Koray","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Birney E","lastName":"Birney","firstName":"Ewan","initials":"E","authorId":{"type":"ORCID","value":"0000-0001-8314-8497"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"European Molecular Biology Laboratory, European Bioinformatics Institute, Hinxton, UK."}]}},{"fullName":"Kohli P","lastName":"Kohli","firstName":"Pushmeet","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Jumper J","lastName":"Jumper","firstName":"John","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-6169-6580"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK. jumper@deepmind.com."}]}},{"fullName":"Hassabis D","lastName":"Hassabis","firstName":"Demis","initials":"D","authorId":{"type":"ORCID","value":"0000-0003-2812-9917"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK. dhcontact@deepmind.com."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-6169-6580"},{"type":"ORCID","value":"0000-0001-8314-8497"},{"type":"ORCID","value":"0000-0001-9928-3407"},{"type":"ORCID","value":"0000-0002-1605-7197"},{"type":"ORCID","value":"0000-0002-2401-5691"},{"type":"ORCID","value":"0000-0002-3227-1505"},{"type":"ORCID","value":"0000-0002-4670-0331"},{"type":"ORCID","value":"0000-0002-6982-4660"},{"type":"ORCID","value":"0000-0002-8439-5964"},{"type":"ORCID","value":"0000-0002-8594-1074"},{"type":"ORCID","value":"0000-0003-1386-8741"},{"type":"ORCID","value":"0000-0003-2429-9812"},{"type":"ORCID","value":"0000-0003-2812-9917"},{"type":"ORCID","value":"0000-0003-4271-4418"},{"type":"ORCID","value":"0000-0003-4675-8469"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data","recommended_reviews"]},"journalInfo":{"issue":"7873","volume":"596","journalIssueId":3221533,"dateOfPublication":"2021 Aug","monthOfPublication":8,"yearOfPublication":2021,"journal":{"medlineAbbreviation":"Nature","title":"Nature","essn":"1476-4687","issn":"0028-0836","nlmid":"0410462","isoabbreviation":"Nature"},"printPublicationDate":"2021-08-01"},"pubYear":"2021","pageInfo":"590-596","abstractText":"Protein structures can provide invaluable information, both for reasoning about biological processes and for enabling interventions such as structure-based drug development or targeted mutagenesis. After decades of effort, 17% of the total residues in human protein sequences are covered by an experimentally determined structure<sup>1</sup>. Here we markedly expand the structural coverage of the proteome by applying the state-of-the-art machine learning method, AlphaFold<sup>2</sup>, at a scale that covers almost the entire human proteome (98.5% of human proteins). The resulting dataset covers 58% of residues with a confident prediction, of which a subset (36% of all residues) have very high confidence. We introduce several metrics developed by building on the AlphaFold model and use them to interpret the dataset, identifying strong multi-domain predictions as well as regions that are likely to be disordered. Finally, we provide some case studies to illustrate how high-quality predictions could be used to generate biological hypotheses. We are making our predictions freely available to the community and anticipate that routine large-scale and high-accuracy structure prediction will become an important tool that will allow new questions to be addressed from a structural perspective.","affiliation":"DeepMind, London, UK. ktkool@deepmind.com.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Glucose-6-Phosphatase","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Membrane Proteins","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Proteome","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Reproducibility of Results"},{"majorTopic_YN":"N","descriptorName":"Computational Biology","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ST","qualifierName":"standards"}]}},{"majorTopic_YN":"Y","descriptorName":"Protein Conformation"},{"majorTopic_YN":"N","descriptorName":"Protein Folding"},{"majorTopic_YN":"Y","descriptorName":"Models, Molecular"},{"majorTopic_YN":"N","descriptorName":"Diacylglycerol O-Acyltransferase","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Datasets as Topic","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"ST","qualifierName":"standards"}]}},{"majorTopic_YN":"N","descriptorName":"Deep Learning","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"ST","qualifierName":"standards"}]}}]},"chemicalList":{"chemical":[{"name":"diacylglycerol O-acyltransferase","registryNumber":"EC 2.3.1.20"},{"name":"Membrane Proteins","registryNumber":"0"},{"name":"Glucose-6-Phosphatase","registryNumber":"EC 3.1.3.9"},{"name":"Proteome","registryNumber":"0"},{"name":"wolframin protein","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Unpaywall","url":"https://www.nature.com/articles/s41586-021-03828-1.pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41586-021-03828-1"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC8387240"},{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC8387240?pdf=render"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"34426694","reference":"Nature. 2021 Aug;596(7873):487-488. doi: 10.1038/d41586-021-02265-4","type":"Comment in","orderIn":1},{"source":"MED","id":"36138210","reference":"Nature. 2022 Sep;609(7929):889. doi: 10.1038/d41586-022-02999-9","type":"Comment in","orderIn":2}]},"isOpenAccess":"Y","inEPMC":"Y","inPMC":"Y","citedByCount":2604,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["go","uniprot","pdb"]},"dateOfCompletion":"2022-02-11","dateOfCreation":"2021-07-22","dateOfRevision":"2024-11-20","electronicPublicationDate":"2021-07-22","firstPublicationDate":"2021-07-22","firstIndexDate":"2021-07-23","fullTextReceivedDate":"2025-02-03","hasEvaluations":"N"},{"id":"31942072","source":"MED","pmid":"31942072","doi":"10.1038/s41586-019-1923-7","title":"Improved protein structure prediction using potentials from deep learning.","authorString":"Senior AW, Evans R, Jumper J, Kirkpatrick J, Sifre L, Green T, Qin C, Žídek A, Nelson AWR, Bridgland A, Penedones H, Petersen S, Simonyan K, Crossan S, Kohli P, Jones DT, Silver D, Kavukcuoglu K, Hassabis D.","authorList":{"author":[{"fullName":"Senior AW","lastName":"Senior","firstName":"Andrew W","initials":"AW","authorId":{"type":"ORCID","value":"0000-0002-2401-5691"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK. andrewsenior@google.com."}]}},{"fullName":"Evans R","lastName":"Evans","firstName":"Richard","initials":"R","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Jumper J","lastName":"Jumper","firstName":"John","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Kirkpatrick J","lastName":"Kirkpatrick","firstName":"James","initials":"J","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Sifre L","lastName":"Sifre","firstName":"Laurent","initials":"L","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Green T","lastName":"Green","firstName":"Tim","initials":"T","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Qin C","lastName":"Qin","firstName":"Chongli","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Žídek A","lastName":"Žídek","firstName":"Augustin","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Nelson AWR","lastName":"Nelson","firstName":"Alexander W R","initials":"AWR","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Bridgland A","lastName":"Bridgland","firstName":"Alex","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Penedones H","lastName":"Penedones","firstName":"Hugo","initials":"H","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Petersen S","lastName":"Petersen","firstName":"Stig","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Simonyan K","lastName":"Simonyan","firstName":"Karen","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Crossan S","lastName":"Crossan","firstName":"Steve","initials":"S","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Kohli P","lastName":"Kohli","firstName":"Pushmeet","initials":"P","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Jones DT","lastName":"Jones","firstName":"David T","initials":"DT","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"The Francis Crick Institute, London, UK."},{"affiliation":"University College London, London, UK."}]}},{"fullName":"Silver D","lastName":"Silver","firstName":"David","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Kavukcuoglu K","lastName":"Kavukcuoglu","firstName":"Koray","initials":"K","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Hassabis D","lastName":"Hassabis","firstName":"Demis","initials":"D","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-2401-5691"}]},"dataLinksTagsList":{"dataLinkstag":["recommended_reviews"]},"journalInfo":{"issue":"7792","volume":"577","journalIssueId":2904552,"dateOfPublication":"2020 Jan","monthOfPublication":1,"yearOfPublication":2020,"journal":{"medlineAbbreviation":"Nature","title":"Nature","essn":"1476-4687","issn":"0028-0836","nlmid":"0410462","isoabbreviation":"Nature"},"printPublicationDate":"2020-01-01"},"pubYear":"2020","pageInfo":"706-710","abstractText":"Protein structure prediction can be used to determine the three-dimensional shape of a protein from its amino acid sequence<sup>1</sup>. This problem is of fundamental importance as the structure of a protein largely determines its function<sup>2</sup>; however, protein structures can be difficult to determine experimentally. Considerable progress has recently been made by leveraging genetic information. It is possible to infer which amino acid residues are in contact by analysing covariation in homologous sequences, which aids in the prediction of protein structures<sup>3</sup>. Here we show that we can train a neural network to make accurate predictions of the distances between pairs of residues, which convey more information about the structure than contact predictions. Using this information, we construct a potential of mean force<sup>4</sup> that can accurately describe the shape of a protein. We find that the resulting potential can be optimized by a simple gradient descent algorithm to generate structures without complex sampling procedures. The resulting system, named AlphaFold, achieves high accuracy, even for sequences with fewer homologous sequences. In the recent Critical Assessment of Protein Structure Prediction<sup>5</sup> (CASP13)-a blind assessment of the state of the field-AlphaFold created high-accuracy structures (with template modelling (TM) scores<sup>6</sup> of 0.7 or higher) for 24 out of 43 free modelling domains, whereas the next best method, which used sampling and contact information, achieved such accuracy for only 14 out of 43 domains. AlphaFold represents a considerable advance in protein-structure prediction. We expect this increased accuracy to enable insights into the function and malfunction of proteins, especially in cases for which no structures for homologous proteins have been experimentally determined<sup>7</sup>.","affiliation":"DeepMind, London, UK. andrewsenior@google.com.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Caspases","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"N","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Proteins","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"GE","qualifierName":"genetics"},{"majorTopic_YN":"Y","abbreviation":"CH","qualifierName":"chemistry"}]}},{"majorTopic_YN":"N","descriptorName":"Amino Acid Sequence"},{"majorTopic_YN":"Y","descriptorName":"Protein Conformation"},{"majorTopic_YN":"N","descriptorName":"Protein Folding"},{"majorTopic_YN":"Y","descriptorName":"Models, Molecular"},{"majorTopic_YN":"Y","descriptorName":"Software"},{"majorTopic_YN":"N","descriptorName":"Datasets as Topic"},{"majorTopic_YN":"Y","descriptorName":"Deep Learning"}]},"chemicalList":{"chemical":[{"name":"caspase 13","registryNumber":"EC 3.4.22.-"},{"name":"Proteins","registryNumber":"0"},{"name":"Caspases","registryNumber":"EC 3.4.22.-"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41586-019-1923-7"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"31988401","reference":"Nature. 2020 Jan;577(7792):627-628. doi: 10.1038/d41586-019-03951-0.","type":"Comment in","orderIn":1},{"source":"MED","id":"32132733","reference":"Nat Methods. 2020 Mar;17(3):249. doi: 10.1038/s41592-020-0779-y.","type":"Comment in","orderIn":2}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":2038,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2020-05-04","dateOfCreation":"2020-01-17","dateOfRevision":"2026-10-10","electronicPublicationDate":"2020-01-15","firstPublicationDate":"2020-01-15","firstIndexDate":"2020-01-17","hasEvaluations":"N"}]}}