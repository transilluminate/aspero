{"version":"6.9","hitCount":35718,"nextCursorMark":"AoJfsgQoNDYxMTAwNTE=","nextPageUrl":"https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=%28alphafold%29&cursorMark=AoJfsgQoNDYxMTAwNTE%3D&resultType=core&pageSize=3&sort=CITED+desc&format=json","request":{"queryString":"(alphafold)","resultType":"core","cursorMark":"*","pageSize":3,"sort":"CITED desc","synonym":false},"resultList":{"result":[{"id":"34265844","source":"MED","pmid":"34265844","pmcid":"PMC8371605","fullTextIdList":{"fullTextId":["PMC8371605"]},"doi":"10.1038/s41586-021-03819-2","title":"Highly accurate protein structure prediction with AlphaFold.","authorString":"Jumper J, Evans R, Pritzel A, Green T, Figurnov M, Ronneberger O, Tunyasuvunakool K, Bates R, Žídek A, Potapenko A, Bridgland A, Meyer C, Kohl SAA, Ballard AJ, Cowie A, Romera-Paredes B, Nikolov S, Jain R, Adler J, Back T, Petersen S, Reiman D, Clancy E, Zielinski M, Steinegger M, Pacholska M, Berghammer T, Bodenstein S, Silver D, Vinyals O, Senior AW, Kavukcuoglu K, Kohli P, Hassabis D.","authorList":{"author":[{"fullName":"Jumper J","lastName":"Jumper","firstName":"John","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-6169-6580"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK. jumper@deepmind.com."}]}},{"fullName":"Evans R","lastName":"Evans","firstName":"Richard","initials":"R","authorId":{"type":"ORCID","value":"0000-0003-4675-8469"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Pritzel A","lastName":"Pritzel","firstName":"Alexander","initials":"A","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Green T","lastName":"Green","firstName":"Tim","initials":"T","authorId":{"type":"ORCID","value":"0000-0002-3227-1505"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"DeepMind, London, UK."}]}},{"fullName":"Figurnov M","lastName":"Figurnov