"Y","citedByCount":12534,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","license":"cc by","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["pdb"]},"dateOfCompletion":"2024-06-12","dateOfCreation":"2024-05-08","dateOfRevision":"2026-04-13","electronicPublicationDate":"2024-05-08","firstPublicationDate":"2024-05-08","firstIndexDate":"2024-05-09","fullTextReceivedDate":"2024-06-28","hasEvaluations":"N"},{"id":"35637307","source":"MED","pmid":"35637307","pmcid":"PMC9184281","fullTextIdList":{"fullTextId":["PMC9184281"]},"doi":"10.1038/s41592-022-01488-1","title":"ColabFold: making protein folding accessible to all.","authorString":"Mirdita M, Schütze K, Moriwaki Y, Heo L, Ovchinnikov S, Steinegger M.","authorList":{"author":[{"fullName":"Mirdita M","lastName":"Mirdita","firstName":"Milot","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-8637-6719"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Quantitative and Computational Biology, Max Planck Institute for Multidisciplinary Sciences, Göttingen, Germany. milot.mirdita@mpinat.mpg.de."}]}},{"fullName":"Schütze K","lastName":"Schütze","firstName":"Konstantin","initials":"K","authorId":{"type":"ORCID","value":"0000-0002-3957-412X"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Biological Sciences, Seoul National University, Seoul, South Korea."}]}},{"fullName":"Moriwaki Y","lastName":"Moriwaki","firstName":"Yoshitaka","initials":"Y","authorId":{"type":"ORCID","value":"0000-0003-0448-9790"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biotechnology, Graduate School of Agricultural and Life Sciences, The University of Tokyo, Tokyo, Japan."},{"affiliation":"Collaborative Research Institute for Innovative Microbiology, The University of Tokyo, Tokyo, Japan."}]}},{"fullName":"Heo L","lastName":"Heo","firstName":"Lim","initials":"L","authorId":{"type":"ORCID","value":"0000-0002-3153-2363"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Biochemistry and Molecular Biology, Michigan State University, East Lansing, MI, USA."}]}},{"fullName":"Ovchinnikov S","lastName":"Ovchinnikov","firstName":"Sergey","initials":"S","authorId":{"type":"ORCID","value":"0000-0003-2774-2744"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"JHDSF Program, Harvard University, Cambridge, MA, USA. so@fas.harvard.edu."},{"affiliation":"FAS Division of Science, Harvard University, Cambridge, MA, USA. so@fas.harvard.edu."}]}},{"fullName":"Steinegger M","lastName":"Steinegger","firstName":"Martin","initials":"M","authorId":{"type":"ORCID","value":"0000-0001-8781-9753"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"School of Biological Sciences, Seoul National University, Seoul, South Korea. martin.steinegger@snu.ac.kr."},{"affiliation":"Artificial Intelligence Institute, Seoul National University, Seoul, South Korea. martin.steinegger@snu.ac.kr."},{"affiliation":"Institute of Molecular Biology and Genetics, Seoul National University, Seoul, South Korea. martin.steinegger@snu.ac.kr."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-8637-6719"},{"type":"ORCID","value":"0000-0001-8781-9753"},{"type":"ORCID","value":"0000-0002-3153-2363"},{"type":"ORCID","value":"0000-0002-3957-412X"},{"type":"ORCID","value":"0000-0003-0448-9790"},{"type":"ORCID","value":"0000-0003-2774-2744"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6","volume":"19","journalIssueId":3373045,"dateOfPublication":"2022 Jun","monthOfPublication":6,"yearOfPublication":2022,"journal":{"medlineAbbreviation":"Nat Methods","title":"Nature methods","essn":"1548-7105","issn":"1548-7091","nlmid":"101215604","isoabbreviation":"Nat Methods"},"printPublicationDate":"2022-06-01"},"pubYear":"2022","pageInfo":"679-682","abstractText":"ColabFold offers accelerated prediction of protein structures and complexes by combining the fast homology search of MMseqs2 with AlphaFold2 or RoseTTAFold. ColabFold's 40-60-fold faster search and optimized model utilization enables prediction of close to 1,000 structures per day on a server with one graphics processing unit. Coupled with Google Colaboratory, ColabFold becomes a free and accessible platform for protein folding. ColabFold is open-source software available at https://github.com/sokrypton/ColabFold and its novel environmental databases are available at https://colabfold.mmseqs.com .","affiliation":"Quantitative and Computational Biology, Max Planck Institute for Multidisciplinary Sciences, Göttingen, Germany. milot.mirdita@mpinat.mpg.de.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Research Support, U.S. Gov't, Non-P.H.S.","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"NIH HHS","acronym":"OD","grantId":"DP5 OD026389","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Proteins"},{"majorTopic_YN":"Y","descriptorName":"Protein Folding"},{"majorTopic_YN":"N","descriptorName":"Computers"},{"majorTopic_YN":"Y","descriptorName":"Software"},{"majorTopic_YN":"N","descriptorName":"Databases, Factual"}]},"chemicalList":{"chemical":[{"name":"Proteins","registryNumber":"0"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"pdf","site":"Unpaywall","url":"https://www.nature.com/articles/s41592-022-01488-1.pdf"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41592-022-01488-1"},{"availability":