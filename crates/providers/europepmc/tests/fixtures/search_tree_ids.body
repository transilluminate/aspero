ding":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"Y","descriptorName":"Computational Biology"},{"majorTopic_YN":"Y","descriptorName":"Software"},{"majorTopic_YN":"N","descriptorName":"Databases, Factual"},{"majorTopic_YN":"Y","descriptorName":"Microbiota"},{"majorTopic_YN":"Y","descriptorName":"Data Science"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Unpaywall","url":"https://research.wur.nl/en/publications/reproducible-interactive-scalable-and-extensible-microbiome-data-"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41587-019-0209-9"},{"availability":"Free","availabilityCode":"F","documentStyle":"html","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC7015180"},{"availability":"Free","availabilityCode":"F","documentStyle":"pdf","site":"Europe_PMC","url":"https://europepmc.org/articles/PMC7015180?pdf=render"},{"availability":"Free","availabilityCode":"F","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/s41587-019-0209-9"}]},"commentCorrectionList":{"commentCorrection":[{"source":"MED","id":"31399723","reference":"Nat Biotechnol. 2019 Sep;37(9):1091. doi: 10.1038/s41587-019-0252-6.","type":"Erratum in","orderIn":1}]},"isOpenAccess":"N","inEPMC":"Y","inPMC":"Y","citedByCount":17548,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"Y","hasBook":"N","hasSuppl":"Y","hasLabsLinks":"Y","hasData":"Y","authMan":"Y","epmcAuthMan":"N","nihAuthMan":"Y","manuscriptId":"NIHMS1064803","hasTMAccessionNumbers":"Y","tmAccessionTypeList":{"accessionType":["gen","doi"]},"dateOfCompletion":"2019-11-06","dateOfCreation":"2019-07-26","dateOfRevision":"2026-11-02","firstPublicationDate":"2019-08-01","firstIndexDate":"2019-07-31","fullTextReceivedDate":"2025-02-05","hasEvaluations":"N"},{"id":"26017442","source":"MED","pmid":"26017442","doi":"10.1038/nature14539","title":"Deep learning.","authorString":"LeCun Y, Bengio Y, Hinton G.","authorList":{"author":[{"fullName":"LeCun Y","lastName":"LeCun","firstName":"Yann","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"1] Facebook AI Research, 770 Broadway, New York, New York 10003 USA. [2] New York University, 715 Broadway, New York, New York 10003, USA."}]}},{"fullName":"Bengio Y","lastName":"Bengio","firstName":"Yoshua","initials":"Y","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Computer Science and Operations Research Université de Montréal, Pavillon André-Aisenstadt, PO Box 6128 Centre-Ville STN Montréal, Quebec H3C 3J7, Canada."}]}},{"fullName":"Hinton G","lastName":"Hinton","firstName":"Geoffrey","initials":"G","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"1] Google, 1600 Amphitheatre Parkway, Mountain View, California 94043, USA. [2] Department of Computer Science, University of Toronto, 6 King's College Road, Toronto, Ontario M5S 3G4, Canada."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-9846-0176"},{"type":"ORCID","value":"0000-0002-0308-2625"},{"type":"ORCID","value":"0009-0007-2540-2611"}]},"dataLinksTagsList":{"dataLinkstag":["recommended_reviews","wikipedia"]},"journalInfo":{"issue":"7553","volume":"521","journalIssueId":2288264,"dateOfPublication":"2015 May","monthOfPublication":5,"yearOfPublication":2015,"journal":{"medlineAbbreviation":"Nature","title":"Nature","essn":"1476-4687","issn":"0028-0836","nlmid":"0410462","isoabbreviation":"Nature"},"printPublicationDate":"2015-05-01"},"pubYear":"2015","pageInfo":"436-444","abstractText":"Deep learning allows computational models that are composed of multiple processing layers to learn representations of data with multiple levels of abstraction. These methods have dramatically improved the state-of-the-art in speech recognition, visual object recognition, object detection and many other domains such as drug discovery and genomics. Deep learning discovers intricate structure in large data sets by using the backpropagation algorithm to indicate how a machine should change its internal parameters that are used to compute the representation in each layer from the representation in the previous layer. Deep convolutional nets have brought about breakthroughs in processing images, video, speech and audio, whereas recurrent nets have shone light on sequential data such as text and speech.","affiliation":"1] Facebook AI Research, 770 Broadway, New York, New York 10003 USA. [2] New York University, 715 Broadway, New York, New York 10003, USA.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","Review","Research Support, U.S. Gov't, Non-P.H.S.","Journal Article"]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Language"},{"majorTopic_YN":"N","descriptorName":"Algorithms"},{"majorTopic_YN":"Y","descriptorName":"Artificial Intelligence","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"N","abbreviation":"TD","qualifierName":"trends"}]}},{"majorTopic_YN":"N","descriptorName":"Computers"},{"majorTopic_YN":"N","descriptorName":"Neural Networks, Computer"}]},"subsetList":{"subset":[{"code":"IM","name":"Index Medicus"}]},"fullTextUrlList":{"fullTextUrl":[{"availability":"Open access","availabilityCode":"OA","documentStyle":"html","site":"Unpaywall","url":"https://hal.science/hal-04206682"},{"availability":"Subscription required","availabilityCode":"S","documentStyle":"doi","site":"DOI","url":"https://doi.org/10.1038/nature14539"}]},"isOpenAccess":"N","inEPMC":"N","inPMC":"N","citedByCount":19522,"hasReferences":"Y","hasTextMinedTerms":"Y","hasDbCrossReferences":"N","hasPDF":"N","hasBook":"N","hasSuppl":"N","hasLabsLinks":"Y","hasData":"N","authMan":"N","epmcAuthMan":"N","nihAuthMan":"N","hasTMAccessionNumbers":"N","dateOfCompletion":"2015-06-29","dateOfCreation":"2015-05-29","dateOfRevision":"2026-10-10","firstPublicationDate":"2015-05-01","firstIndexDate":"2015-05-29","hasEvaluations":"N"}]}}