{"links":{"self":"/works/OL8008683W/editions.json?limit=100","work":"/works/OL8008683W"},"size":3,"entries":[{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2666297A"}],"isbn_13":["9781283185158"],"languages":[{"key":"/languages/eng"}],"pagination":"256","publish_date":"2014","publishers":["Palgrave Macmillan"],"source_records":["bwb:9781283185158"],"subjects":["English drama, history and criticism, 17th century","English drama, history and criticism, early modern and elizabethan, 1500-1600","Theater, history","Sex role in motion pictures"],"title":"Early Modern Tragedy, Gender and Performance, 1984-2000","full_title":"Early Modern Tragedy, Gender and Performance, 1984-2000","works":[{"key":"/works/OL8008683W"}],"key":"/books/OL39512801M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2022-09-17T08:53:31.751094"},"last_modified":{"type":"/type/datetime","value":"2022-09-17T08:53:31.751094"}},{"type":{"key":"/type/edition"},"authors":[{"key":"/authors/OL2666297A"}],"isbn_13":["9780230597488"],"languages":[{"key":"/languages/eng"}],"lc_classifications":["PN1-PN6790"],"pagination":"xii, 237","publish_date":"2007","publishers":["Palgrave Macmillan"],"source_records":["bwb:9780230597488"],"subjects":["Gender identity in literature"],"title":"Early Modern Tragedy, Gender and Performance, 1984-2000","subtitle":"The Destined Livery","full_title":"Early Modern Tragedy, Gender and Performance, 1984-2000 The Destined Livery","works":[{"key":"/works/OL8008683W"}],"key":"/books/OL35770549M","latest_revision":1,"revision":1,"created":{"type":"/type/datetime","value":"2021-12-25T09:10:17.192145"},"last_modified":{"type":"/type/datetime","value":"2021-12-25T09:10:17.192145"}},{"publishers":["Palgrave Macmillan"],"identifiers":{"goodreads":["5895346"]},"subtitle":"The Destined Livery","weight":"15.5 ounces","covers":[2745131],"physical_format":"Hardcover","lc_classifications":["PN849.G74HM401-1281P","PR658.T7 B39 2007"],"key":"/books/OL11643101M","authors":[{"key":"/authors/OL2666297A"}],"subjects":["Film theory & criticism","Gender studies","Plays & playwrights: 16th to 18th centuries","Theatre, drama","Literary Criticism","Literature - Classics / Criticism","British Isles","Literary Criticism & Collections / English, Irish, Scottish, Welsh","English, Irish, Scottish, Welsh","17th century","Early modern and Elizabethan, 1500-1600","English drama","English drama (Tragedy)","History and criticism"],"isbn_13":["9781403994790"],"source_records":["amazon:140399479X","marc:marc_loc_updates/v38.i08.records.utf8:7133352:2022","bwb:9781403994790","marc:marc_loc_2016/BooksAll.2016.part34.utf8:132697834:2498","marc:marc_columbia/Columbia-extract-20221130-013.mrc:254001834:2140","promise:bwb_daily_pallets_2023-04-17:P8-DGJ-945","marc:harvard_bibliographic_metadata/ab.bib.11.20150123.full.mrc:113907674:2118","ia:earlymoderntrage0000bark","marc:harvard_bibliographic_metadata/20220215_041.bib.mrc:96245911:5858"],"title":"Early Modern Tragedy, Gender and Performance, 1984-2000","number_of_pages":240,"languages":[{"key":"/languages/eng"}],"isbn_10":["140399479X"],"publish_date":"October 2, 2007","works":[{"key":"/works/OL8008683W"}],"type":{"key":"/type/edition"},"physical_dimensions":"8.4 x 5.6 x 0.8 inches","lccn":["2007025502"],"oclc_numbers":["145938938"],"local_id":["urn:bwbsku:P8-DGJ-945"],"ocaid":"earlymoderntrage0000bark","description":{"type":"/type/text","value":"What happens when contemporary actors perform the rigid gender roles that help to shape the doomed characters of much early modern English tragedy? How do their performances affect contemporary audiences and contemporary society? Early Modern Tragedy, Gender and Performance, 1984-2000 strives to answer this question by advancing a new model for politically engaged spectatorship of contemporary productions by Shakespeare and his contemporaries. Using nine recent theatrical and cinematic productions as case studies, it offers close analyses of the contradictions and tensions that arise when contemporary actors perform the gender norms of a previous culture in a manner calculated to suit the norms of our own time. Because it shows how both actors and spectators can have an impact on current debates about gender roles, it will be of interest to theatre practitioners as well as to students of early modern drama, of performance, and of gender studies."},"latest_revision":14,"revision":14,"created":{"type":"/type/datetime","value":"2008-04-30T20:50:18.033121"},"last_modified":{"type":"/type/datetime","value":"2026-06-18T14:28:56.187059"}}]}